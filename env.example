# Copy to .env and fill in your key:  cp env.example .env
# --- LLM (generation) -------------------------------------------------------
# DeepSeek is OpenAI-compatible. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
GENERATION_MAX_TOKENS=700

# --- Qdrant ------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_hybrid

# --- Embeddings / reranking (OpenRouter API) --------------------------------
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=qwen/qwen3-embedding-8b
EMBED_DIM=4096
EMBED_BATCH_SIZE=32
RERANKER_MODEL=mongodb/rerank-3-lite

# --- Retrieval / chunking -----------------------------------------------------
CHUNK_SPLIT_BY=word        # word | sentence | page
CHUNK_SIZE=400
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=20         # candidates per hybrid retrieval before reranking
RERANK_TOP_K=5             # documents kept after cross-encoder reranking

# --- Web UI (rag-hybrid serve) ------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000
